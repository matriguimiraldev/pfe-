# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Realtime stream (SSE)
REAL_TIME_ZIGZAG=https://your-realtime-endpoint/stream
REAL_TIME_ZIGZAG_CONNECT_TIMEOUT=10
REAL_TIME_ZIGZAG_READ_TIMEOUT=60
REAL_TIME_ZIGZAG_RECONNECT_DELAY=2

# Piper (optionnel)
# Si piper.exe n'est pas dans le PATH, indiquez son chemin complet.
PIPER_EXE=C:\path\to\piper.exe
